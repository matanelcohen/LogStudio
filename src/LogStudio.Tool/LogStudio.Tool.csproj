<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>logstudio</ToolCommandName>
    <PackageId>LogStudio.Tool</PackageId>
    <Description>Explore console commands or selected running .NET applications with disk-backed localhost logs, conditional filters and streaming exports.</Description>
    <PackageTags>console;logging;log-viewer;dotnet-tool;local-development</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LogStudio.Tests" />
    <ProjectReference Include="../LogStudio/LogStudio.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../frontend/dist/third-party-notices.txt" Pack="true" PackagePath="/" />
    <None Include="../LogStudio/dependency-notices.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
  </ItemGroup>
</Project>
