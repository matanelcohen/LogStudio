<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <DefineConstants Condition="'$(MedeinaRepositoryRoot)' != ''">$(DefineConstants);MEDEINA_COLOR_CONSOLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="System" Condition="'$(MedeinaRepositoryRoot)' != ''" />
    <ProjectReference Include="../../src/LogStudio/LogStudio.csproj" />
    <ProjectReference Include="../../src/LogStudio.Tool/LogStudio.Tool.csproj" />
    <ProjectReference Include="../../samples/LogStudio.Demo/LogStudio.Demo.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DemoPath</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../../samples/LogStudio.Demo/bin/$(Configuration)/net10.0/LogStudio.Demo.dll'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ToolPath</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../../src/LogStudio.Tool/bin/$(Configuration)/net10.0/LogStudio.Tool.dll'))</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="$(MedeinaRepositoryRoot)/test/shared/Medeina.Console.Color/ColorConsole.cs" Link="ExistingMedeina/ColorConsole.cs" Condition="'$(MedeinaRepositoryRoot)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LogStudio.Desktop\LogStudio.Desktop.csproj" />
  </ItemGroup>
</Project>
